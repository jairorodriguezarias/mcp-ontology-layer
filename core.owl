<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://banco.es/ontologies/core"
         xmlns="http://banco.es/ontologies/core#">

<owl:Ontology rdf:about="http://banco.es/ontologies/core"/>

<owl:Class rdf:about="#FinancialProduct"/>

<owl:Class rdf:about="#Loan">
  <rdfs:subClassOf rdf:resource="#FinancialProduct"/>
</owl:Class>

<owl:Class rdf:about="#PrestamoHipotecario">
  <rdfs:subClassOf rdf:resource="#Loan"/>
</owl:Class>

<owl:Class rdf:about="#PersonalLoan">
  <rdfs:subClassOf rdf:resource="#Loan"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Hipoteca_Fija_001">
  <rdf:type rdf:resource="#PrestamoHipotecario"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Hipoteca_Variable_01">
  <rdf:type rdf:resource="#PrestamoHipotecario"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Hipoteca_Fija_02">
  <rdf:type rdf:resource="#PrestamoHipotecario"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Credito_Consumo_03">
  <rdf:type rdf:resource="#PrestamoHipotecario"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Loan_Auto_2026_01">
  <rdf:type rdf:resource="#PersonalLoan"/>
  <term rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</term>
  <principal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24500.00</principal>
  <rate rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.75</rate>
  <currency>EUR</currency>
</owl:NamedIndividual>


</rdf:RDF>
